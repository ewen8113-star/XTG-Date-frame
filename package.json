{
  "name": "xtg-review-admin",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --restart-tries -1 --restart-after 3000 -n api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "vite --host 0.0.0.0 --port 5174 --strictPort",
    "dev:api": "API_PORT=3131 tsx src/server/index.ts",
    "build": "tsc && vite build",
    "test": "tsc --noEmit && tsx --test src/lib/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-test": "tsx prisma/seed-test.ts",
    "db:clear-preview": "tsx prisma/clear-preview.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.10.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.11.5",
    "prisma": "^6.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "styled-components": "^6.4.4",
    "tsx": "^4.19.2",
    "vite": "^6.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.2"
  }
}
